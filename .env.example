# ====================================================================
# QChinese – AI 汉语私人教师 Backend Configuration
# Copy file này thành ".env" và điền API Key nếu muốn dùng Gemini/OpenAI.
# LƯU Ý BẢO MẬT: Tuyệt đối KHÔNG đưa API Key vào mã Frontend hoặc GitHub!
# ====================================================================

PORT=8000
HOST=0.0.0.0

# Tùy chọn 1: Google Gemini API (Khuyên dùng - Nhanh & Chính xác tiếng Trung/Việt)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Tùy chọn 2: OpenAI hoặc API tương thích OpenAI (Groq / OpenRouter)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
